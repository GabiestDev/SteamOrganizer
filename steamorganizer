# ---------- protobuf wire parser ----------
def varint(b, i):
    r = s = 0
    while True:
        c = b[i]; i += 1
        r |= (c & 0x7f) << s
        if not c & 0x80: return r, i
        s += 7

def fields(b):
    i, out = 0, []
    while i < len(b):
        k, i = varint(b, i)
        f, w = k >> 3, k & 7
        if w == 0:
            v, i = varint(b, i)
        elif w == 2:
            l, i = varint(b, i); v = b[i:i+l]; i += l
        elif w == 5:
            v = int.from_bytes(b[i:i+4], 'little'); i += 4
        elif w == 1:
            v = int.from_bytes(b[i:i+8], 'little'); i += 8
        else:
            raise ValueError(w)
        out.append((f, w, v))
    return out

def parse_overview_pb(path):
    b = open(path, 'rb').read()
    apps = []
    for f, w, v in fields(b):
        if f == 1 and w == 2:
            d = {}; tags = []
            for ff, ww, vv in fields(v):
                if ff == 19 and ww == 0: tags.append(vv)
                elif ff == 2 and ww == 2: d['name'] = vv.decode('utf-8','replace')
