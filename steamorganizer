###############################################################################
# 1. Detectar instalação Steam
###############################################################################
detect_steam_paths() {
    local found=()
    local candidates=(
        "$HOME/.local/share/Steam"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
        "$HOME/snap/steam/common/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
    )
    for c in "${candidates[@]}"; do
        [ -d "$c" ] && found+=("$c")
    done
    if [ ${#found[@]} -eq 0 ]; then
        echo ""
    elif [ ${#found[@]} -eq 1 ]; then
        echo "${found[0]}"
    else
        gum choose --header "Múltiplas instalações Steam encontradas. Escolha uma:" "${found[@]}"
    fi
}

STEAM_PATH="$(detect_steam_paths)"
