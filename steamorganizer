def classify(app):
    t = app.get('apptype', 1)
    tags = app.get('tags', [])
    tnames = tag_names(tags)
    top = set(tnames[:8])

    if t == 4: return ['🛠️ Ferramentas']
    if t in (8, 65536): return ['🧪 Demos & Betas']
    if t in (2, 256): return ['🛠️ Ferramentas']
    if t in (2048, 8192): return ['🎬 Trilhas & Vídeos']

    aid = str(app.get('appid'))
    if aid in MANUAL:
        cols = [MANUAL[aid]]
    elif 'MMORPG' in tnames[:3]:
        cols = ['🌐 MMO']
    else:
        cols = ['📁 Outros']
        for x in tnames:
            if x in TAG2CAT:
                cols = [TAG2CAT[x]]
                break

    if top & COOP: cols.append('🤝 Co-op')
    if top & PVP: cols.append('⚔️ Competitivo')
    if 'VR' in tags or 'VR' in tnames: cols.append('🥽 VR')
    if 'Indie' in tnames and '🕹️ Indie & Retrô' not in cols: cols.append('🕹️ Indie & Retrô')
    if app.get('installed', False): cols.append('📦 Instalados')
    now = time.time()
    if app.get('play2w', 0) > 0 or (app.get('lastplayed', 0) and now - app['lastplayed'] < 30*86400 and app.get('playtime', 0) > 0):
        cols.append('▶️ Jogando Agora')
    return list(dict.fromkeys(cols))

# ---------- bibliotecas ----------
def build_library_full():
    """Captura biblioteca completa via CEF debug (requer Steam rodando com -cef-enable-debugging)."""
    steam_bin = shutil.which("steam") or "/usr/bin/steam"
    env = os.environ.copy()
    marker = "/tmp/steamorganizer_debug_marker"
    if not os.path.exists(marker):
        subprocess.Popen([steam_bin, "-cef-enable-debugging"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(30):
            s = socket.socket()
            try:
                s.connect(("127.0.0.1", 8080)); s.close(); break
            except Exception:
                time.sleep(1)
        open(marker, "w").close()

    try:
        import websocket
    except ImportError:
        print("websocket-client não instalado. Use: pip install websocket-client")
        return []

    buf = {"data": None}
    def on_message(ws, message):
        m = json.loads(message)
        if m.get('id') == 1 and 'result' in m:
            buf['data'] = m['result']['result']['value']
            ws.close()

    def on_open(ws):
        expr = ("window.__ovbuf=null;SteamClient.Apps.RegisterForAppOverviewChanges(b=>{window.__ovbuf=b});"
                "setTimeout(()=>{},2500)")
        ws.send(json.dumps({"id":1,"method":"Runtime.evaluate","params":{"expression":expr,"returnByValue":True,"awaitPromise":True}}))

    ws = websocket.WebSocketApp("ws://127.0.0.1:8080/devtools/page/placeholder", on_open=on_open, on_message=on_message)
    # Precisamos do URL real do SharedJSContext. Vamos buscar os targets primeiro.
    import urllib.request
    targets = json.loads(urllib.request.urlopen("http://127.0.0.1:8080/json", timeout=5).read())
    shared = [t for t in targets if t.get('title') == 'SharedJSContext']
    if not shared:
        print("SharedJSContext não encontrado. Rode a Steam com -cef-enable-debugging.")
        return []
    ws_url = shared[0]['webSocketDebuggerUrl']

    ws = websocket.WebSocketApp(ws_url, on_open=on_open, on_message=on_message)
    ws.run_forever(timeout=10)

    if buf['data'] is None:
        return []

    import base64
    raw = base64.b64decode(buf['data'])
    pb_path = os.path.join(BACKUP, "overview.pb")
    open(pb_path, 'wb').write(raw)
    apps = parse_overview_pb(pb_path)

    now = time.time()
    out = []
    for a in apps:
        out.append({
            'appid': str(a.get('appid')),
            'name': a.get('name') or '',
            'apptype': a.get(7, 1),
            'tags': a.get('tags', []),
            'installed': (a.get(37, 0) or 0) > 0,
            'playtime': a.get(16, 0) or 0,
            'play2w': a.get(17, 0) or 0,
            'lastplayed': a.get(14, 0) or 0,
        })
    return out

def build_library_fast():
    """Constrói a partir do appinfo.vdf + localconfig (mais rápido, menos completo)."""
    try:
        import vdf
    except ImportError:
        print("módulo vdf não instalado. pip install vdf")
        return []

    apps_data = {}
    try:
        ai = vdf.load(open(APPINFO, encoding='utf-8', errors='replace'))
        for appid, app in ai.get('apps', {}).items():
            common = app.get('common', {})
            apps_data[appid] = {
                'appid': appid,
                'name': common.get('name', ''),
                'apptype': 1,
                'tags': app.get('store_tags', []) or [],
                'installed': False,
                'playtime': 0,
                'play2w': 0,
                'lastplayed': 0,
            }
    except Exception as e:
        print(f"appinfo.vdf não lido: {e}")

    try:
        lc = vdf.load(open(LC, encoding='utf-8', errors='replace'))
        userapps = lc.get('UserLocalConfigStore', {}).get('apps', {})
        for appid, app in userapps.items():
            if appid in apps_data:
                apps_data[appid]['playtime'] = app.get('playtime', 0) or 0
                apps_data[appid]['lastplayed'] = app.get('lastplayed', 0) or 0
                apps_data[appid]['installed'] = (app.get('installed', 0) or 0) == 1
            else:
                apps_data[appid] = {
                    'appid': appid,
                    'name': app.get('name', ''),
                    'apptype': 1,
                    'tags': [],
                    'installed': (app.get('installed', 0) or 0) == 1,
                    'playtime': app.get('playtime', 0) or 0,
                    'play2w': 0,
                    'lastplayed': app.get('lastplayed', 0) or 0,
                }
    except Exception as e:
        print(f"localconfig.vdf não lido: {e}")

    return list(apps_data.values())

def main():
    backup(CS)
    backup(LC)

    if USE_FULL:
        rows = build_library_full()
        if not rows:
            print("Falha ao capturar biblioteca completa. Usando modo rápido.")
            rows = build_library_fast()
    else:
        rows = build_library_fast()

    hidden = set()
    try:
        d = json.load(open(CS))
        for e in d:
            if e[0] == 'user-collections.hidden':
                try:
                    hidden = set(json.loads(e[1]['value']).get('added', []))
                except: pass
    except: pass

    groups = {}
    for r in rows:
        aid = int(r['appid'])
        if aid in hidden: continue
        for c in classify(r):
            groups.setdefault(c, set()).add(aid)

    # Aplicar nomes customizados do usuário
    final_groups = {}
    for c, appids in groups.items():
        nome_exibicao = c
        for interno, info in CATS.items():
            if interno in c or c.endswith(interno):
                nome_exibicao = info.get('nome', c)
                break
        final_groups.setdefault(nome_exibicao, set()).update(appids)

    # Franquias
    if CRIAR_FAM:
        franchise_apps = set()
        for r in rows:
            if r.get('apptype', 1) not in (1, 2): continue
            aid = int(r['appid'])
            if aid in hidden: continue
            name = (r.get('name') or '').replace('®','').replace('™','')
            if BAD_FRANCHISE_APP.search(name): continue
            for fname, pat, emoji in FRANCHISES:
                if re.search(pat, name, re.IGNORECASE):
                    franchise_apps.add(aid); break
        if franchise_apps:
            final_groups[NOME_FAM] = franchise_apps

    # Montar ordem de gravação
    ORDER = []
    for interno, info in CATS.items():
        if info.get('ativo'):
            ORDER.append(info.get('nome', interno) + ' ' + info.get('emoji', ''))
    if CRIAR_FAM: ORDER.append(NOME_FAM)
    if CRIAR_INSTAL: ORDER.append(NOME_INSTAL)

    # Gravar JSON
    d = json.load(open(CS))
    by_key = {e[0]: e for e in d}
    existing_by_name = {}
    for e in d:
        if e[0].startswith('user-collections.') and not e[1].get('is_deleted'):
            try: v = json.loads(e[1]['value'])
            except: continue
            if v.get('name'): existing_by_name[v['name']] = e[0]

    rnd = random.Random(int(time.time()))
    def new_id():
        while True:
            k = 'uc-' + ''.join(rnd.choice(string.ascii_letters + string.digits) for _ in range(12))
            if 'user-collections.' + k not in by_key:
                return k

    now = int(time.time())
    created = updated = 0

    for name in ORDER:
        apps = sorted(final_groups.get(name, set()))
        if not apps and name != NOME_INSTAL: continue
        key = existing_by_name.get(name)
        if key:
            updated += 1
        else:
            key = 'user-collections.' + new_id(); created += 1
        val = {'id': key.split('.', 1)[1], 'name': name, 'added': apps, 'removed': []}
        entry = [key, {'key': key, 'timestamp': now, 'value': json.dumps(val, ensure_ascii=False, separators=(',',':')), 'version': '596'}]
        if key in by_key:
            idx = next(i for i,x in enumerate(d) if x[0] == key); d[idx] = entry
        else:
            d.append(entry)
        by_key[key] = entry

    # Renomear coleção instalados localmente se existir
    if CRIAR_INSTAL:
        inst_key = existing_by_name.get('Instalados localmente') or existing_by_name.get(NOME_INSTAL)
        if inst_key and inst_key in by_key:
            e = by_key[inst_key]
            v = json.loads(e[1]['value'])
            v['name'] = NOME_INSTAL
            e[1]['value'] = json.dumps(v, ensure_ascii=False, separators=(',',':'))
            e[1]['timestamp'] = now

    tmp = CS + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(d, f, ensure_ascii=False)
    os.replace(tmp, CS)

    print(f"BACKUP: {BACKUP}")
    print(f"Criadas: {created}, Atualizadas: {updated}")
    print(f"Total jogos classificados: {len(rows)}")
    for name in ORDER:
        print(f"  {len(final_groups.get(name, set())):4d}  {name}")

if __name__ == '__main__':
    main()
